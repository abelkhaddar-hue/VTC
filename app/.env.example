# Copier en app/.env.local puis remplir. Ces deux valeurs sont publiques par nature (elles finissent dans l'app) :
# la sécurité vient des règles RLS de la base, pas du secret de ces clés.

# fake = démo en mémoire (par défaut) ; supabase = vraie base
EXPO_PUBLIC_DATA_SOURCE=fake

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# JAMAIS ici : la clé secrète / service_role, le mot de passe de la base, les clés Twilio ou Google.
